{# Lab page: the homepage split into a top nav, the prose, and a footer that
   waits below the fold, laid over a dithered field drawn in the site's own
   paper tokens. The prose column is a clearing in the field. No card, no
   blur, no motion: the field is still, and different tomorrow.

   Query string knobs:
     ?study=meadow|thicket|heath|blossom|strata   pick the composition
     ?accent=clay|moss|none                        the one colour allowed in
     ?seed=123    any integer; the default seed is today's date
     ?cell=4      cell size in CSS px, 2 to 10 #}
<style>
  .field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    display: block;
    image-rendering: pixelated;
  }
  .sprig { display: none; }

  /* The first screen holds the nav and the prose; the footer sits below it
     and is reached by scrolling. */
  .plate {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .top {
    padding-top: 1.5rem;
    padding-bottom: 0;
  }
  .top .label,
  .top .note { display: none; }
  .top .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
  }
  .top .links li {
    padding: 0;
    border: 0;
  }
  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .stage .hello { margin-top: 0; }
  .tail {
    padding-top: 0;
    padding-bottom: 2.5rem;
  }
  .tail footer { margin-top: 0; }
  .js .tail {
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 600ms ease, transform 600ms ease;
  }
  .js .tail.in {
    opacity: 1;
    transform: none;
  }
  .field-line {
    margin: 0.25rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-align: center;
  }

  /* Phones: the field becomes a plate above the prose, dissolving into the
     paper at its foot. */
  @media (max-width: 44rem) {
    .field {
      position: static;
      height: clamp(200px, 34vh, 320px);
    }
    .plate { min-height: 0; }
    .stage {
      justify-content: flex-start;
      padding-top: 1.5rem;
    }
  }
</style>

<div class="plate">
  <nav class="wrapper top" aria-label="Elsewhere">
    {% include "home-links.njk" %}
  </nav>
  <canvas class="field" aria-hidden="true"></canvas>
  <main class="wrapper stage">
    {% include "home-hello.njk" %}

    {% include "home-notes.njk" %}
  </main>
</div>
<div class="wrapper tail">
  {% include "home-footer.njk" %}
  <p class="field-line"></p>
</div>

<script>
(function () {
  var canvas = document.querySelector(".field");
  var column = document.querySelector(".stage");
  var line = document.querySelector(".field-line");
  var q = new URLSearchParams(location.search);
  var STUDIES = ["meadow", "thicket", "heath", "blossom", "strata"];
  var ACCENTS = ["clay", "moss"];

  // The day's seed. Everyone who visits on the same day gets the same field
  // at the same window size.
  var today = new Date();
  var seedParam = parseInt(q.get("seed"), 10);
  var seed = isNaN(seedParam)
    ? today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate()
    : seedParam;
  var cellParam = parseInt(q.get("cell"), 10);
  var CELL = cellParam >= 2 && cellParam <= 10 ? cellParam : 4;

  var s, lattice;
  function rand() {
    s = s + 0x6D2B79F5 | 0;
    var t = Math.imul(s ^ s >>> 15, 1 | s);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  }
  function rnd(a, b) { return a + rand() * (b - a); }
  function pick(arr) { return arr[Math.floor(rand() * arr.length)]; }

  function lat(ix, iy) { return lattice[((ix * 73856093) ^ (iy * 19349663)) & 1023]; }
  function noise(x, y) {
    var ix = Math.floor(x), iy = Math.floor(y), fx = x - ix, fy = y - iy;
    fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy);
    var a = lat(ix, iy), b = lat(ix + 1, iy), c = lat(ix, iy + 1), d = lat(ix + 1, iy + 1);
    return (a + (b - a) * fx) * (1 - fy) + (c + (d - c) * fx) * fy;
  }
  function fbm(x, y) {
    return noise(x, y) * 0.5 + noise(x * 2.1 + 7.3, y * 2.1 + 3.1) * 0.3 +
      noise(x * 4.3 + 11.7, y * 4.3 + 5.9) * 0.2;
  }
  function smooth(u) { u = Math.max(0, Math.min(1, u)); return u * u * (3 - 2 * u); }

  // Ordered dithering: the screen's oldest texture.
  var BAYER = [
    [0, 32, 8, 40, 2, 34, 10, 42], [48, 16, 56, 24, 50, 18, 58, 26],
    [12, 44, 4, 36, 14, 46, 6, 38], [60, 28, 52, 20, 62, 30, 54, 22],
    [3, 35, 11, 43, 1, 33, 9, 41], [51, 19, 59, 27, 49, 17, 57, 25],
    [15, 47, 7, 39, 13, 45, 5, 37], [63, 31, 55, 23, 61, 29, 53, 21]
  ];
  function level(v, L, thr) {
    v = Math.max(0, Math.min(1, v));
    var lv = v * (L - 1), b = Math.floor(lv);
    return Math.min(L - 1, b + (lv - b > thr ? 1 : 0));
  }

  function token(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
  function rgb(hex) {
    hex = hex.replace("#", "");
    if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
    return [parseInt(hex.slice(0, 2), 16), parseInt(hex.slice(2, 4), 16), parseInt(hex.slice(4, 6), 16)];
  }

  // --- Regions -----------------------------------------------------------
  // The same composition builders as the painted lab, minus colour. A region
  // carries a type, a texture style, and sometimes a base tone.
  var W, H, phone, blobs, bands, horizon, skyReg, baseReg, study, accent, acc;
  var TEX = ["grass", "grass", "hatch", "dots", "rows", "stubble", "smooth"];

  function lobe(cx, cy, rx, ry) { return { cx: cx, cy: cy, rx: rx, ry: ry, seed: rnd(0, 100) }; }
  function addBlob(b) { b.tex = rnd(0, 100); blobs.push(b); return b; }
  function mound(type, cx, cy, rx, ry, style, extra) {
    var b = addBlob({ type: type, style: style, lobes: [lobe(cx, cy, rx, ry)] });
    for (var l = 0; l < extra; l++) {
      b.lobes.push(lobe(cx + rx * rnd(-0.9, 0.9), cy + ry * rnd(-0.7, 0.5), rx * rnd(0.4, 0.9), ry * rnd(0.4, 0.9)));
    }
    return b;
  }
  function ribbon(width, y0, y1) {
    var pts = [], x = W * rnd(-0.1, 0.5), y = rnd(y0, y1), ang = rnd(-0.6, 0.6);
    for (var k = 0; k < 40; k++) {
      pts.push({ x: x, y: y });
      ang += rnd(-0.35, 0.35); ang = Math.max(-1.2, Math.min(1.2, ang));
      x += Math.cos(ang) * W * 0.03; y += Math.sin(ang) * W * 0.03;
    }
    return addBlob({ type: "ribbon", pts: pts, width: width });
  }
  function band(reg, y) { reg.top = y; reg.wob = rnd(0, 100); bands.push(reg); return reg; }

  function insideLobe(lb, x, y) {
    var dx = (x - lb.cx) / lb.rx, dy = (y - lb.cy) / lb.ry;
    var q2 = dx * dx + dy * dy;
    if (q2 > 1.7) return false;
    var r = 0.7 + 0.6 * fbm(x / 110 + lb.seed, y / 110 + lb.seed);
    return q2 < r * r;
  }
  function inside(b, x, y) {
    if (b.pts) {
      var w = b.width * (0.6 + 0.8 * fbm(x / 60 + b.tex, y / 60));
      for (var k = 0; k < b.pts.length; k++) {
        var dx = x - b.pts[k].x, dy = y - b.pts[k].y;
        if (dx * dx + dy * dy < w * w) return true;
      }
      return false;
    }
    for (k = 0; k < b.lobes.length; k++) if (insideLobe(b.lobes[k], x, y)) return true;
    return false;
  }
  function bandTop(reg, x) { return reg.top + (fbm(x / 200 + reg.wob, reg.wob) - 0.5) * H * 0.12; }
  function baseAt(x, y) {
    if (bands) {
      for (var k = bands.length - 1; k > 0; k--) if (y >= bandTop(bands[k], x)) return bands[k];
      return bands[0];
    }
    if (horizon >= 0) {
      var hz = horizon + (fbm(x / 160, 3.3) - 0.5) * H * 0.1;
      return y < hz ? skyReg : baseReg;
    }
    return baseReg;
  }
  function regionAt(x, y) {
    var r = baseAt(x, y);
    for (var k = 0; k < blobs.length; k++) if (inside(blobs[k], x, y)) r = blobs[k];
    return r;
  }
  function nearestLobe(b, x, y) {
    var best = b.lobes[0], bd = Infinity;
    for (var k = 0; k < b.lobes.length; k++) {
      var lb = b.lobes[k], dx = (x - lb.cx) / lb.rx, dy = (y - lb.cy) / lb.ry, d = dx * dx + dy * dy;
      if (d < bd) { bd = d; best = lb; }
    }
    return best;
  }

  function buildMeadow() {
    horizon = H * rnd(0.2, 0.42);
    skyReg = { type: "sky" };
    baseReg = { type: "ground", style: "grass", tex: 5 };
    var n = Math.round(rnd(2, 5));
    for (var i = 0; i < n; i++) {
      var b = mound("canopy", W * rnd(0.05, 0.95), horizon - H * rnd(-0.02, 0.16), W * rnd(0.08, 0.22), H * rnd(0.08, 0.22), "smooth", Math.round(rnd(0, 3)));
      b.accent = rand() < 0.35;
    }
    n = Math.round(rnd(4, 8));
    for (i = 0; i < n; i++) mound("ground", W * rnd(0.05, 0.95), rnd(horizon + H * 0.04, H), W * rnd(0.2, 0.55), H * rnd(0.08, 0.26), pick(TEX), 0);
    n = Math.round(rnd(0, 3));
    for (i = 0; i < n; i++) mound("ground", W * rnd(0.05, 0.95), H * rnd(0.75, 1), W * rnd(0.03, 0.08), H * rnd(0.2, 0.5), pick(["grass", "stubble", "rows"]), 0);
    n = Math.round(rnd(1, 4));
    for (i = 0; i < n; i++) mound("patch", W * rnd(0.1, 0.9), rnd(horizon - H * 0.05, H * 0.85), W * rnd(0.03, 0.09), H * rnd(0.03, 0.09), "dots", 0);
    n = Math.round(rnd(1, 3));
    for (i = 0; i < n; i++) ribbon(rnd(8, 30), horizon, H);
  }
  function buildThicket() {
    baseReg = { type: "bare" };
    var n = Math.round(rnd(2, 4));
    for (var i = 0; i < n; i++) mound("ground", W * rnd(0.1, 0.9), H * rnd(0.5, 1.1), W * rnd(0.25, 0.6), H * rnd(0.1, 0.3), pick(["grass", "stubble", "hatch"]), 0);
    n = Math.round(rnd(6, 12));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.2);
      var b = mound("mound", W * rnd(0, 1), H * rnd(0.1, 1), rx, Math.min(H * 0.35, rx * rnd(0.6, 1.3)), "smooth", Math.round(rnd(0, 2)));
      b.accent = rand() < 0.2;
    }
  }
  function buildHeath() {
    bands = [];
    var n = Math.round(rnd(3, 5)), y = 0;
    for (var i = 0; i < n; i++) {
      band({ type: "ground", style: pick(["rows", "rows", "stubble", "dots", "hatch"]), tex: rnd(0, 100), tone: rnd(0.18, 0.48) }, y);
      y += H / n * rnd(0.6, 1.4);
    }
    n = Math.round(rnd(1, 2));
    for (i = 0; i < n; i++) { var r = ribbon(rnd(30, 70), H * 0.2, H); r.flat = true; }
    n = Math.round(rnd(2, 5));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.04, 0.12);
      var b = mound("mound", W * rnd(0.05, 0.95), H * rnd(0.15, 0.95), rx, rx * rnd(0.5, 0.9), "smooth", Math.round(rnd(0, 1)));
      b.accent = rand() < 0.3;
    }
  }
  function buildBlossom() {
    baseReg = { type: "ground", style: "stubble", tex: 2, tone: 0.18 };
    var n = Math.round(rnd(5, 10));
    for (var i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.18);
      var b = mound("blossom", W * rnd(0, 1), H * rnd(0, 1), rx, rx * rnd(0.7, 1.1), "smooth", 0);
      b.ringW = rnd(8, 18);
    }
  }
  function buildStrata() {
    bands = [];
    var n = Math.round(rnd(5, 9)), y = 0, tops = [];
    for (var i = 0; i < n; i++) {
      var sky = i === 0 && rand() < 0.6;
      band({ type: sky ? "sky" : "ground", style: sky ? "smooth" : pick(TEX.concat(["rows"])), tex: rnd(0, 100), tone: sky ? 0 : rnd(0.14, 0.58) }, y);
      tops.push(y); y += H / n * rnd(0.5, 1.5);
    }
    n = Math.round(rnd(1, 4));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.16);
      var b = mound("mound", W * rnd(0.05, 0.95), pick(tops.slice(1)), rx, rx * rnd(0.5, 1), "smooth", Math.round(rnd(0, 2)));
      b.accent = rand() < 0.4;
    }
    n = Math.round(rnd(0, 2));
    for (i = 0; i < n; i++) ribbon(rnd(8, 24), H * 0.2, H);
  }
  var BUILD = { meadow: buildMeadow, thicket: buildThicket, heath: buildHeath, blossom: buildBlossom, strata: buildStrata };

  // --- Tone --------------------------------------------------------------
  // Each cell gets a tone from 0 (paper) to 1 (ink). Texture is pattern, not
  // brushwork: rows, hatching, dot grids, fine noise.
  function texture(style, x, y, i, j, t) {
    switch (style) {
      case "grass": return (noise(x / 5 + t, y / 30 + t) - 0.5) * 0.3;
      case "hatch": return (i + j) % 4 === 0 ? 0.12 : -0.04;
      case "rows": return j % 3 === 0 ? 0.12 : -0.05;
      case "dots": return i % 3 === 0 && j % 3 === 0 ? 0.22 : -0.05;
      case "stubble": return (noise(x / 3 + t, y / 3 + t) - 0.5) * 0.3;
      default: return 0;
    }
  }
  function toneAt(reg, x, y, i, j) {
    var t = reg.tex || 0, lb, v;
    switch (reg.type) {
      case "sky": {
        var hz = horizon >= 0 ? horizon : H * 0.4;
        v = 0.03 + 0.1 * fbm(x / 320, y / 240) + 0.05 * Math.min(1, y / hz);
        break;
      }
      case "ground": {
        var top = horizon >= 0 ? horizon : reg.top || 0;
        var depth = Math.min(1, Math.max(0, (y - top) / Math.max(1, H - top)));
        var base = reg.tone != null ? reg.tone : 0.22 + 0.22 * depth;
        v = base + (fbm(x / 150 + t, y / 100 + t) - 0.5) * 0.3 + texture(reg.style, x, y, i, j, t);
        break;
      }
      case "bare":
        v = 0.1 + (fbm(x / 120, y / 120) - 0.5) * 0.14 + texture("stubble", x, y, i, j, 1) * 0.4;
        break;
      case "canopy":
      case "mound": {
        lb = nearestLobe(reg, x, y);
        var ny = (y - lb.cy) / lb.ry, nx = (x - lb.cx) / lb.rx;
        v = 0.5 + 0.22 * ny + 0.1 * nx + (fbm(x / 55 + t, y / 55 + t) - 0.5) * 0.36;
        acc = !!reg.accent;
        break;
      }
      case "blossom": {
        lb = nearestLobe(reg, x, y);
        var d = Math.hypot(x - lb.cx, y - lb.cy) + (fbm(x / 90 + t, y / 90) - 0.5) * reg.ringW * 0.9;
        if (Math.floor(Math.abs(d) / reg.ringW) % 2 === 0) { acc = true; v = 0.7; }
        else v = 0.45;
        v += (fbm(x / 40 + t, y / 40) - 0.5) * 0.3;
        break;
      }
      case "patch":
        acc = true;
        v = 0.55 + (fbm(x / 40 + t, y / 40) - 0.5) * 0.4;
        break;
      case "ribbon":
        v = reg.flat ? 0.06 : 0.1 + texture("dots", x, y, i, j, t) * 0.5;
        break;
      default: v = 0.3;
    }
    return v;
  }

  // --- Render ------------------------------------------------------------
  function render() {
    s = seed | 0;
    lattice = [];
    for (var i = 0; i < 1024; i++) lattice.push(rand());
    var sp = q.get("study");
    study = STUDIES.indexOf(sp) >= 0 ? sp : pick(STUDIES);
    var ap = q.get("accent");
    accent = ap === "none" || ACCENTS.indexOf(ap) >= 0 ? ap : pick(ACCENTS);

    phone = matchMedia("(max-width: 44rem)").matches;
    W = canvas.clientWidth; H = canvas.clientHeight;
    if (!W || !H) return;
    blobs = []; bands = null; horizon = -1; skyReg = baseReg = null;
    BUILD[study]();

    var tones = [null, rgb(token("--rule")), rgb(token("--ink-soft")), rgb(token("--ink"))];
    var accCol = rgb(token(accent === "moss" ? "--moss" : "--clay"));
    var useAcc = accent !== "none";

    // The clearing: the prose column, with a feathered, wandering edge.
    var rect = column.getBoundingClientRect();
    var colL = rect.left + 8, colR = rect.right - 8, FEATHER = 120;
    function clearing(x, y) {
      if (phone) return smooth((H - y) / (H * 0.4));
      var wob = (fbm(y / 160 + 7, 2) - 0.5) * 48;
      var l = colL + wob, r = colR + wob;
      if (x > l && x < r) return 0;
      return smooth((x < l ? l - x : x - r) / FEATHER);
    }

    var cols = Math.ceil(W / CELL), rows = Math.ceil(H / CELL);
    var off = document.createElement("canvas");
    off.width = cols; off.height = rows;
    var octx = off.getContext("2d");
    var img = octx.createImageData(cols, rows), px = img.data;
    for (var j = 0; j < rows; j++) {
      for (i = 0; i < cols; i++) {
        var x = (i + 0.5) * CELL, y = (j + 0.5) * CELL;
        acc = false;
        var reg = regionAt(x, y);
        var v = toneAt(reg, x, y, i, j) * clearing(x, y);
        var thr = (BAYER[j & 7][i & 7] + 0.5) / 64;
        var c = acc && useAcc ? (level(v, 2, thr) ? accCol : null) : tones[level(v, 4, thr)];
        if (!c) continue;
        var k = (j * cols + i) * 4;
        px[k] = c[0]; px[k + 1] = c[1]; px[k + 2] = c[2]; px[k + 3] = 255;
      }
    }
    octx.putImageData(img, 0, 0);

    var dpr = Math.min(2, window.devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    var ctx = canvas.getContext("2d");
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(off, 0, 0, cols * CELL * dpr, rows * CELL * dpr);

    canvas.setAttribute("data-field", study + " " + accent + " " + seed);
    if (line) line.textContent = study + " · " + seed;
  }

  // Draw after the text has had its first paint, and again when the window
  // or the colour scheme changes. A draw costs tens of milliseconds.
  requestAnimationFrame(function () { setTimeout(render, 0); });
  var timer;
  addEventListener("resize", function () { clearTimeout(timer); timer = setTimeout(render, 150); });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", render);

  // The footer waits below the fold and fades in when scrolled to.
  document.documentElement.classList.add("js");
  var tail = document.querySelector(".tail");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { tail.classList.add("in"); io.disconnect(); } });
    }, { threshold: 0.2 });
    io.observe(tail);
  } else {
    tail.classList.add("in");
  }
})();
</script>
