{# Lab page: the real homepage body laid over a generated painting.

   Query string knobs, so variants can be compared without editing:
     ?mode=full   painting fills the whole window (default)
     ?mode=band   painting fills the lower part of the window
     ?study=meadow|thicket|heath|blossom|strata   pick the composition
     ?palette=dusk|hot|chalk|spring|ember         pick the mood
     ?seed=123    any integer; the default seed is today's date
     ?density=1   stroke density multiplier, 0.5 to 2
     ?still=1     paint instantly instead of over a few seconds #}
<style>
  .landscrape {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    z-index: -2;
    pointer-events: none;
    display: block;
  }
  .landscrape.band {
    height: 52vh;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 38%);
    mask-image: linear-gradient(to bottom, transparent, #000 38%);
  }
  .landscrape.full {
    top: 0;
    height: 100%;
  }
  /* The prose sits on a sheet of paper laid over the painting. */
  .lab-card .sprig { display: none; }
  .lab-card {
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(0.9);
    backdrop-filter: blur(10px) saturate(0.9);
    border-radius: 2px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--rule) 60%, transparent);
  }
  /* On a narrow screen there is no room beside the prose, so the painting
     becomes a header strip and the prose sits on plain paper below it. */
  @media (max-width: 44rem) {
    .landscrape, .landscrape.full, .landscrape.band {
      position: static;
      height: 42vh;
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent);
      mask-image: linear-gradient(to bottom, #000 62%, transparent);
    }
    .lab-card {
      margin-top: -3rem;
      padding-top: 1rem;
    }
  }
  @media (min-width: 44rem) {
    .lab-card {
      margin-top: 3rem;
      margin-bottom: 3rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
      padding-left: 3rem;
      padding-right: 3rem;
      max-width: calc(var(--measure) + 6rem);
    }
  }
</style>

<canvas class="landscrape" aria-hidden="true"></canvas>

<div class="wrapper lab-card">
{% include "home.njk" %}
</div>
<script>
(function () {
  var canvas = document.querySelector(".landscrape");
  if (!canvas) return;
  var q = new URLSearchParams(location.search);
  var mode = q.get("mode") === "band" ? "band" : "full";
  canvas.classList.add(mode);
  var densityMul = Math.min(2, Math.max(0.5, parseFloat(q.get("density")) || 1));
  var still = q.get("still") === "1" ||
    (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);

  // --- Seeded randomness -------------------------------------------------
  // The seed is today's date, so the painting changes once a day and
  // everyone who visits on the same day sees the same one.
  var today = new Date();
  var seed = parseInt(q.get("seed"), 10) ||
    today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
  var s = seed | 0;
  function rand() {
    s = s + 0x6D2B79F5 | 0;
    var t = Math.imul(s ^ s >>> 15, 1 | s);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  }
  function rnd(a, b) { return a + rand() * (b - a); }
  function pick(arr) { return arr[Math.floor(rand() * arr.length)]; }
  function pick2(arr) { var a = pick(arr), b = pick(arr); return b === a ? [a, pick(arr)] : [a, b]; }

  // Smooth value noise on a lattice, three octaves. Enough to make edges
  // wander and colour drift the way a brush does.
  var lattice = [];
  for (var i = 0; i < 1024; i++) lattice.push(rand());
  function lat(ix, iy) { return lattice[((ix * 73856093) ^ (iy * 19349663)) & 1023]; }
  function noise(x, y) {
    var ix = Math.floor(x), iy = Math.floor(y), fx = x - ix, fy = y - iy;
    fx = fx * fx * (3 - 2 * fx); fy = fy * fy * (3 - 2 * fy);
    var a = lat(ix, iy), b = lat(ix + 1, iy), c = lat(ix, iy + 1), d = lat(ix + 1, iy + 1);
    return (a + (b - a) * fx) * (1 - fy) + (c + (d - c) * fx) * fy;
  }
  function fbm(x, y) {
    return noise(x, y) * 0.5 + noise(x * 2.1 + 7.3, y * 2.1 + 3.1) * 0.3 +
      noise(x * 4.3 + 11.7, y * 4.3 + 5.9) * 0.2;
  }

  // --- Temperaments (HSL triples) ----------------------------------------
  // Five moods. Each gives the painting a ground colour, a sky, colours for
  // the massed shapes, the open fields, the blooms, and the line drawn over
  // the top. The day's seed picks one.
  var PALETTES = {
    dusk: { ground: [30, 40, 50], line: [270, 30, 28],
      sky: [[272, 45, 72], [285, 38, 64], [300, 30, 72], [232, 35, 76]],
      mass: [[150, 55, 30], [140, 50, 42], [128, 55, 58], [100, 45, 50], [165, 45, 36]],
      field: [[42, 55, 52], [22, 42, 40], [26, 40, 50], [268, 35, 72], [50, 58, 80], [135, 45, 48],
              [88, 50, 55], [18, 55, 45], [350, 30, 55], [46, 70, 58]],
      bloom: [[52, 82, 58], [56, 72, 72], [335, 58, 66], [20, 80, 62]],
      accent: [[335, 60, 65], [218, 65, 55], [52, 90, 60], [25, 85, 60], [45, 30, 92]] },
    hot: { ground: [225, 45, 22], line: [220, 40, 14],
      sky: [[205, 70, 55], [195, 60, 65], [40, 80, 70]],
      mass: [[95, 70, 45], [80, 80, 55], [150, 60, 35], [200, 60, 45], [320, 65, 50], [25, 85, 55]],
      field: [[330, 70, 55], [20, 85, 60], [85, 65, 50], [210, 70, 50], [55, 90, 60], [170, 55, 45], [280, 50, 55]],
      bloom: [[330, 80, 62], [45, 95, 65], [15, 90, 58], [200, 80, 70]],
      accent: [[55, 95, 65], [330, 85, 65], [205, 85, 60], [20, 95, 55]] },
    chalk: { ground: [28, 50, 90], line: [20, 30, 45],
      sky: [[25, 55, 88], [345, 40, 86], [200, 30, 86]],
      mass: [[110, 25, 55], [140, 20, 45], [160, 20, 60], [95, 30, 62]],
      field: [[30, 45, 82], [350, 35, 78], [80, 25, 70], [200, 25, 75], [45, 40, 78], [20, 30, 65]],
      bloom: [[345, 55, 72], [40, 70, 78], [20, 70, 72]],
      accent: [[345, 60, 65], [210, 45, 65], [45, 75, 70]] },
    spring: { ground: [90, 45, 60], line: [120, 40, 24],
      sky: [[205, 55, 82], [195, 45, 88], [60, 50, 90]],
      mass: [[110, 60, 45], [95, 65, 55], [130, 55, 38], [75, 60, 55], [150, 50, 42]],
      field: [[85, 60, 60], [60, 70, 65], [110, 50, 52], [45, 80, 70], [130, 45, 55], [340, 45, 72]],
      bloom: [[335, 75, 72], [350, 65, 78], [48, 90, 72], [0, 70, 70]],
      accent: [[335, 80, 70], [48, 95, 65], [210, 60, 65], [20, 90, 65]] },
    ember: { ground: [355, 45, 25], line: [0, 40, 14],
      sky: [[20, 70, 60], [35, 80, 65], [350, 50, 55]],
      mass: [[85, 45, 40], [60, 50, 45], [120, 35, 32], [30, 60, 45], [345, 55, 45]],
      field: [[25, 80, 50], [10, 70, 45], [45, 70, 55], [350, 55, 50], [75, 45, 45], [290, 35, 45]],
      bloom: [[48, 95, 62], [25, 95, 60], [340, 70, 62]],
      accent: [[48, 95, 65], [200, 55, 55], [330, 70, 60], [90, 70, 55]] }
  };
  var PNAMES = Object.keys(PALETTES);
  var paletteName = PALETTES[q.get("palette")] ? q.get("palette") : pick(PNAMES);
  var P = PALETTES[paletteName];

  // Five studies, the compositions. The seed picks one of these too.
  var STUDIES = ["meadow", "thicket", "heath", "blossom", "strata"];
  var study = STUDIES.indexOf(q.get("study")) >= 0 ? q.get("study") : pick(STUDIES);
  canvas.setAttribute("data-study", study + " " + paletteName + " " + seed);

  function clamp(v) { return Math.max(0, Math.min(100, v)); }
  function hsla(c, dh, ds, dl, a) {
    return "hsla(" + (c[0] + dh) + "," + clamp(c[1] + ds) + "%," + clamp(c[2] + dl) + "%," + a + ")";
  }

  // --- Canvas ------------------------------------------------------------
  var dpr = Math.min(2, window.devicePixelRatio || 1);
  var W = canvas.clientWidth, H = canvas.clientHeight;
  canvas.width = Math.round(W * dpr);
  canvas.height = Math.round(H * dpr);
  var ctx = canvas.getContext("2d");
  ctx.scale(dpr, dpr);
  ctx.lineCap = "round";
  ctx.lineJoin = "round";

  // --- Regions -----------------------------------------------------------
  // A region is a patch of the canvas with two colours, a mark style, and a
  // chance of leaving the ground bare. The base is either a sky over a
  // horizon or a stack of bands; shapes sit on top, last one wins.
  var blobs = [], bands = null, horizon = -1, skyReg = null, baseReg = null, bg, passes = [];
  var STYLES = ["grass", "grass", "hatch", "dots", "comma", "stubble", "weave"];

  function lobe(cx, cy, rx, ry) { return { cx: cx, cy: cy, rx: rx, ry: ry, seed: rnd(0, 100) }; }
  function addBlob(b) { b.id = blobs.length; b.tex = rnd(0, 100); b.skip = b.skip || 0; blobs.push(b); return b; }
  function mound(type, cx, cy, rx, ry, colors, style, extra) {
    var b = addBlob({ type: type, colors: colors, style: style, lobes: [lobe(cx, cy, rx, ry)] });
    for (var l = 0; l < extra; l++) {
      b.lobes.push(lobe(cx + rx * rnd(-0.9, 0.9), cy + ry * rnd(-0.7, 0.5), rx * rnd(0.4, 0.9), ry * rnd(0.4, 0.9)));
    }
    return b;
  }
  function ribbon(colors, style, width, y0, y1) {
    var pts = [], x = W * rnd(-0.1, 0.5), y = rnd(y0, y1), ang = rnd(-0.6, 0.6);
    for (var k = 0; k < 40; k++) {
      pts.push({ x: x, y: y });
      ang += rnd(-0.35, 0.35); ang = Math.max(-1.2, Math.min(1.2, ang));
      x += Math.cos(ang) * W * 0.03; y += Math.sin(ang) * W * 0.03;
    }
    return addBlob({ type: "ribbon", colors: colors, style: style, pts: pts, width: width });
  }
  function band(reg, y) { reg.top = y; reg.wob = rnd(0, 100); bands.push(reg); return reg; }

  function insideLobe(lb, x, y) {
    var dx = (x - lb.cx) / lb.rx, dy = (y - lb.cy) / lb.ry;
    var r = 0.7 + 0.6 * fbm(x / 110 + lb.seed, y / 110 + lb.seed);
    return dx * dx + dy * dy < r * r;
  }
  function inside(b, x, y) {
    if (b.pts) {
      var w = b.width * (0.6 + 0.8 * fbm(x / 60 + b.tex, y / 60));
      for (var k = 0; k < b.pts.length; k++) {
        var dx = x - b.pts[k].x, dy = y - b.pts[k].y;
        if (dx * dx + dy * dy < w * w) return true;
      }
      return false;
    }
    for (k = 0; k < b.lobes.length; k++) if (insideLobe(b.lobes[k], x, y)) return true;
    return false;
  }
  function bandTop(reg, x) { return reg.top + (fbm(x / 200 + reg.wob, reg.wob) - 0.5) * H * 0.12; }
  function baseAt(x, y) {
    if (bands) {
      for (var k = bands.length - 1; k > 0; k--) if (y >= bandTop(bands[k], x)) return bands[k];
      return bands[0];
    }
    if (horizon >= 0) {
      var hz = horizon + (fbm(x / 160, 3.3) - 0.5) * H * 0.1;
      return y < hz ? skyReg : baseReg;
    }
    return baseReg;
  }
  function regionAt(x, y) {
    var r = baseAt(x, y);
    for (var k = 0; k < blobs.length; k++) if (inside(blobs[k], x, y)) r = blobs[k];
    return r;
  }
  function nearestLobe(b, x, y) {
    var best = b.lobes[0], bd = 1e9;
    for (var k = 0; k < b.lobes.length; k++) {
      var dx = x - b.lobes[k].cx, dy = y - b.lobes[k].cy, d = dx * dx + dy * dy;
      if (d < bd) { bd = d; best = b.lobes[k]; }
    }
    return best;
  }
  // Which of a region's two colours a point takes: by noise, or by ring
  // around the centre for the blossom heads. And a slow drift of warmth
  // across the whole canvas so no field is one flat note.
  function colorAt(reg, x, y) {
    if (reg.style === "ringdots") {
      var lb = nearestLobe(reg, x, y), d = Math.hypot(x - lb.cx, y - lb.cy);
      d += (fbm(x / 90 + reg.tex, y / 90) - 0.5) * reg.ringW * 0.9;
      return reg.colors[Math.floor(Math.abs(d) / reg.ringW) % 2];
    }
    var mix = fbm(x / 140 + reg.tex, y / 140 + reg.tex);
    return reg.colors[mix > 0.5 ? 1 : 0];
  }
  function drift(x, y) {
    return { h: (fbm(x / 420 + 20, y / 420) - 0.5) * 26, l: (fbm(x / 300 + 40, y / 300) - 0.5) * 16 };
  }

  // --- The studies -------------------------------------------------------
  function buildMeadow() {
    // A horizon, canopies against the sky, a patchwork of fields below.
    horizon = H * rnd(0.2, 0.42);
    skyReg = { type: "sky", colors: pick2(P.sky), style: "smear", tex: 3, skip: 0.72 };
    baseReg = { type: "ground", colors: pick2(P.field), style: "grass", tex: 5, skip: 0 };
    bg = skyReg.colors[0];
    var n = Math.round(rnd(2, 5));
    for (var i = 0; i < n; i++) {
      var b = mound("canopy", W * rnd(0.05, 0.95), horizon - H * rnd(-0.02, 0.16), W * rnd(0.08, 0.22), H * rnd(0.08, 0.22),
        pick2(P.mass), pick(["dab", "dab", "comma", "radial"]), Math.round(rnd(0, 3)));
      b.bloom = pick(P.bloom); b.blooming = rand() < 0.7; b.branches = true;
    }
    n = Math.round(rnd(4, 8));
    for (i = 0; i < n; i++) {
      mound("ground", W * rnd(0.05, 0.95), rnd(horizon + H * 0.04, H), W * rnd(0.2, 0.55), H * rnd(0.08, 0.26), pick2(P.field), pick(STYLES), 0);
    }
    n = Math.round(rnd(0, 3));
    for (i = 0; i < n; i++) {
      mound("ground", W * rnd(0.05, 0.95), H * rnd(0.75, 1), W * rnd(0.03, 0.08), H * rnd(0.2, 0.5), pick2(P.field), pick(["grass", "stubble", "weave"]), 0);
    }
    n = Math.round(rnd(1, 4));
    for (i = 0; i < n; i++) {
      mound("patch", W * rnd(0.1, 0.9), rnd(horizon - H * 0.05, H * 0.85), W * rnd(0.03, 0.09), H * rnd(0.03, 0.09), pick2(P.accent), "dots", 0);
    }
    n = Math.round(rnd(1, 3));
    for (i = 0; i < n; i++) ribbon([pick(P.accent), pick(P.field)], pick(["stubble", "dots", "comma"]), rnd(8, 30), horizon, H);
    passes = ["branches", "contours", "drips"];
  }

  function buildThicket() {
    // No horizon. Rounded masses crowd the whole canvas, built from marks
    // that burst outward from each centre, with the dark ground showing
    // through the gaps.
    bg = P.ground;
    baseReg = { type: "bare", colors: [P.ground, pick(P.field)], style: "sparse", tex: 1, skip: 0.7 };
    var n = Math.round(rnd(2, 4));
    for (var i = 0; i < n; i++) {
      var f = mound("ground", W * rnd(0.1, 0.9), H * rnd(0.5, 1.1), W * rnd(0.25, 0.6), H * rnd(0.1, 0.3), pick2(P.field), pick(["grass", "stubble", "hatch"]), 0);
      f.skip = 0.25;
    }
    n = Math.round(rnd(6, 12));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.2);
      var b = mound("mound", W * rnd(0, 1), H * rnd(0.1, 1), rx, Math.min(H * 0.35, rx * rnd(0.6, 1.3)),
        rand() < 0.7 ? pick2(P.mass) : pick2(P.field), pick(["radial", "radial", "dab", "ring", "comma"]), Math.round(rnd(0, 2)));
      b.bloom = pick(P.bloom); b.blooming = rand() < 0.6; b.branches = rand() < 0.5;
    }
    passes = ["branches", "contours", "scribbles"];
  }

  function buildHeath() {
    // Open ground. Loose horizontal bands, much of the ground left bare, a
    // flat path or two wandering through, a few low bushes.
    bg = P.ground;
    bands = [];
    var n = Math.round(rnd(3, 5)), y = 0;
    for (var i = 0; i < n; i++) {
      band({ type: "ground", colors: pick2(P.field), style: pick(["scrape", "scrape", "stubble", "dots", "hatch"]), tex: rnd(0, 100), skip: rnd(0.3, 0.55) }, y);
      y += H / n * rnd(0.6, 1.4);
    }
    n = Math.round(rnd(1, 2));
    for (i = 0; i < n; i++) {
      var c = pick(P.accent);
      var r = ribbon([c, c], "sparse", rnd(30, 70), H * 0.2, H); r.flat = true; r.skip = 0.85;
    }
    n = Math.round(rnd(2, 5));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.04, 0.12);
      var b = mound("mound", W * rnd(0.05, 0.95), H * rnd(0.15, 0.95), rx, rx * rnd(0.5, 0.9), pick2(P.mass), pick(["dab", "radial"]), Math.round(rnd(0, 1)));
      b.bloom = pick(P.bloom); b.blooming = rand() < 0.5;
    }
    passes = ["contours", "drips", "scribbles"];
  }

  function buildBlossom() {
    // Heads of blossom: rings of dots around scattered centres, alternating
    // two colours, over a loose grass of short ticks.
    bg = P.ground;
    baseReg = { type: "ground", colors: pick2(P.field), style: "stubble", tex: 2, skip: 0.35 };
    var n = Math.round(rnd(5, 10));
    for (var i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.18);
      var b = mound("blossom", W * rnd(0, 1), H * rnd(0, 1), rx, rx * rnd(0.7, 1.1),
        [pick(P.bloom), rand() < 0.5 ? pick(P.mass) : pick(P.bloom)], "ringdots", 0);
      b.ringW = rnd(6, 14); b.skip = 0.15;
    }
    passes = ["scribbles"];
  }

  function buildStrata() {
    // Terraces: a stack of bands, each its own colour and mark, with a few
    // masses sitting on the steps between them.
    bands = [];
    var n = Math.round(rnd(5, 9)), y = 0, tops = [];
    for (var i = 0; i < n; i++) {
      var sky = i === 0 && rand() < 0.6;
      band({ type: sky ? "sky" : "ground", colors: pick2(sky ? P.sky : rand() < 0.4 ? P.mass : P.field),
        style: sky ? "smear" : pick(STYLES.concat(["scrape", "radial"])), tex: rnd(0, 100), skip: sky ? 0.7 : rnd(0, 0.3) }, y);
      tops.push(y); y += H / n * rnd(0.5, 1.5);
    }
    bg = bands[0].colors[0];
    n = Math.round(rnd(1, 4));
    for (i = 0; i < n; i++) {
      var rx = W * rnd(0.06, 0.16);
      var b = mound("mound", W * rnd(0.05, 0.95), pick(tops.slice(1)), rx, rx * rnd(0.5, 1), pick2(P.mass), pick(["dab", "radial", "comma"]), Math.round(rnd(0, 2)));
      b.bloom = pick(P.bloom); b.blooming = rand() < 0.6; b.branches = rand() < 0.6;
    }
    n = Math.round(rnd(0, 2));
    for (i = 0; i < n; i++) ribbon([pick(P.accent), pick(P.field)], pick(["stubble", "dots"]), rnd(8, 24), H * 0.2, H);
    passes = ["branches", "contours", "drips"];
  }

  ({ meadow: buildMeadow, thicket: buildThicket, heath: buildHeath, blossom: buildBlossom, strata: buildStrata })[study]();

  // --- Underpainting -----------------------------------------------------
  // Flat, soft, slightly darker than the marks to come.
  function fillBelow(topFn, color) {
    ctx.fillStyle = color; ctx.beginPath(); ctx.moveTo(0, H);
    for (var x = 0; x <= W; x += 8) ctx.lineTo(x, topFn(x));
    ctx.lineTo(W, H); ctx.closePath(); ctx.fill();
  }
  ctx.fillStyle = hsla(bg, 0, 0, 0, 1);
  ctx.fillRect(0, 0, W, H);
  if (bands) {
    bands.forEach(function (reg, i) { if (i) fillBelow(function (x) { return bandTop(reg, x); }, hsla(reg.colors[0], 0, -5, -3, 1)); });
  } else if (horizon >= 0) {
    fillBelow(function (x) { return horizon + (fbm(x / 160, 3.3) - 0.5) * H * 0.1; }, hsla(baseReg.colors[0], 0, -5, -3, 1));
  }
  blobs.forEach(function (b) {
    var dark = b.type === "canopy" || b.type === "mound" ? -8 : b.type === "blossom" ? -12 : -3;
    ctx.fillStyle = hsla(b.colors[0], 0, -5, dark, b.flat ? 1 : 0.92);
    if (b.pts) {
      ctx.lineWidth = b.width * 1.6; ctx.strokeStyle = ctx.fillStyle;
      ctx.beginPath(); b.pts.forEach(function (p, j) { j ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y); }); ctx.stroke();
      return;
    }
    b.lobes.forEach(function (lb) {
      ctx.beginPath();
      for (var a = 0; a < 64; a++) {
        var th = a / 64 * Math.PI * 2;
        var px = lb.cx + Math.cos(th) * lb.rx, py = lb.cy + Math.sin(th) * lb.ry;
        var r = 0.7 + 0.6 * fbm(px / 110 + lb.seed, py / 110 + lb.seed);
        px = lb.cx + Math.cos(th) * lb.rx * r; py = lb.cy + Math.sin(th) * lb.ry * r;
        a ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
      }
      ctx.closePath(); ctx.fill();
    });
  });

  // --- Marks -------------------------------------------------------------
  // The heuristic: thousands of small marks, each taking its colour from the
  // region underneath with a little drift, its shape from that region's
  // style, and its length from how far down the canvas it sits. Nothing is
  // drawn as a thing. The landscape is what the marks add up to.
  var count = Math.round(W * H / 26 * densityMul * (study === "blossom" ? 1.3 : 1));
  var strokes = [];
  for (i = 0; i < count; i++) {
    var x = rand() * W, y = rand() * H;
    var reg = regionAt(x, y);
    if (rand() < reg.skip) continue;
    var depth = horizon >= 0 ? Math.max(0, (y - horizon) / (H - horizon)) : y / H;
    var accentField = fbm(x / 70 + 50, y / 70 + 50);
    var dr = drift(x, y);
    var color = colorAt(reg, x, y), dh = rnd(-9, 9) + dr.h, ds = rnd(-12, 10), dl = rnd(-13, 13) + dr.l;
    var style = reg.style, massy = reg.type === "canopy" || reg.type === "mound";
    if (massy) { dh += rnd(-6, 6); dl += rnd(-9, 9); ds -= 8; }
    if (reg.type === "sky") { dl = rnd(-5, 5) + dr.l * 0.5; ds = rnd(-8, 4); if (rand() < 0.12) style = "drizzle"; }
    if (reg.type === "bare") { dl = rnd(-4, 8); ds = rnd(-20, -5); }
    if (massy && reg.blooming && accentField > 0.56 && rand() < 0.6) {
      color = reg.bloom; dh = rnd(-4, 4); dl = rnd(-6, 10); style = "flower";
    } else if (reg.type === "ground" && accentField > 0.66 && rand() < 0.18) {
      color = pick(P.accent); dh = rnd(-4, 4);
    }
    var cx = 0, cy = 0, ang = reg.tex % 1 * 1.4 - 0.7; // a fixed slant per field, for hatching
    if (style === "radial" || style === "ring") {
      var lb = reg.lobes ? nearestLobe(reg, x, y) : { cx: W / 2, cy: H * 1.2 };
      cx = lb.cx; cy = lb.cy; ang = Math.atan2(y - cy, x - cx) + rnd(-0.45, 0.45);
    }
    // Masses get a cluster of dabs where the ground gets one stroke.
    var reps = massy && style !== "ring" ? 3 : reg.type === "patch" ? 2 : 1;
    for (var k = 0; k < reps; k++) {
      strokes.push({ x: x + (k ? rnd(-7, 7) : 0), y: y + (k ? rnd(-7, 7) : 0), st: style, d: depth, cx: cx, cy: cy,
        c: hsla(color, dh + (k ? rnd(-8, 8) : 0), ds, dl + (k ? rnd(-10, 10) : 0), 1),
        a: reg.type === "sky" ? rnd(0.2, 0.4) : rnd(0.4, 0.85),
        len: rnd(5, 14) * (1 + 1.8 * depth), w: rnd(1.1, 2.6),
        lean: rnd(-0.16, 0.16), ang: ang, r: rnd(1.2, 5.5), cv: rnd(-6, 6) });
    }
  }
  // Paint top to bottom, the way the underpainting went down.
  strokes.sort(function (p, q2) { return p.y - q2.y; });

  function line(x1, y1, x2, y2, w) {
    ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
  }
  function curve(x1, y1, cx, cy, x2, y2, w) {
    ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.quadraticCurveTo(cx, cy, x2, y2); ctx.stroke();
  }
  function dot(x, y, r) { ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill(); }

  function paint(st) {
    ctx.globalAlpha = st.a;
    ctx.strokeStyle = ctx.fillStyle = st.c;
    var x = st.x, y = st.y, L = st.len;
    switch (st.st) {
      case "dab": dot(x, y, st.r); break;
      case "sparse": dot(x, y, st.r * 0.6); break;
      case "flower":
        for (var k = 0; k < 4; k++) dot(x + Math.cos(k * 1.6) * 2.4, y + Math.sin(k * 1.6) * 2.4, st.r * 0.45);
        break;
      case "dots": dot(x, y, st.r * 0.7); break;
      case "ringdots": dot(x, y, st.r * 0.8); break;
      case "smear": line(x - L, y, x + L * 0.4, y + st.lean * 4, st.w + 1.2); break;
      case "scrape": ctx.globalAlpha = st.a * 0.7; line(x - L * 1.5, y, x + L * 1.5, y + st.lean * 6, st.w * 2.2); break;
      case "drizzle": line(x, y, x + st.lean * 6, y + L * 2.2, 0.9); break;
      case "hatch":
        line(x, y, x + Math.sin(st.ang + 0.9) * L, y - Math.cos(st.ang + 0.9) * L, st.w); break;
      case "radial":
        if (st.r < 2.6) { dot(x, y, st.r + 0.8); break; }
        line(x, y, x + Math.cos(st.ang) * L * 0.45, y + Math.sin(st.ang) * L * 0.45, st.w); break;
      case "ring":
        var rr = Math.max(4, Math.hypot(x - st.cx, y - st.cy)), da = Math.min(1, L * 0.5 / rr);
        ctx.lineWidth = st.w + 0.5; ctx.beginPath(); ctx.arc(st.cx, st.cy, rr, st.ang - da, st.ang + da); ctx.stroke();
        break;
      case "comma":
        curve(x, y, x + st.cv, y - L * 0.5, x + st.cv * 0.4, y - L * 0.9, st.w + 0.6); break;
      case "stubble": line(x, y, x + st.lean * 3, y - L * 0.45, st.w); break;
      case "weave":
        if (st.r > 3.3) line(x - L * 0.4, y, x + L * 0.4, y, st.w);
        else line(x, y, x, y - L * 0.8, st.w);
        break;
      default: // grass: a slightly curved blade
        curve(x, y, x + st.cv * 0.5, y - L * 0.5, x + Math.sin(st.lean) * L + st.cv, y - L, st.w);
    }
  }

  // --- Finishing passes --------------------------------------------------
  // Branches: a few dark lines wandering through each mass, so it has some
  // bones in it.
  function branches() {
    blobs.forEach(function (b) {
      if (!b.branches) return;
      var n = Math.round(rnd(3, 9));
      for (var k = 0; k < n; k++) {
        var lb = pick(b.lobes), x = lb.cx + rnd(-0.5, 0.5) * lb.rx, y = lb.cy + rnd(-0.3, 0.8) * lb.ry;
        var ang = rnd(-Math.PI * 0.9, -Math.PI * 0.1), segs = Math.round(rnd(6, 18));
        ctx.globalAlpha = rnd(0.35, 0.6);
        ctx.strokeStyle = hsla(b.colors[0], rnd(-20, 10), -15, rnd(-28, -14), 1);
        ctx.lineWidth = rnd(0.9, 1.9);
        ctx.beginPath(); ctx.moveTo(x, y);
        for (var j = 0; j < segs; j++) {
          ang += rnd(-0.5, 0.5); x += Math.cos(ang) * rnd(5, 11); y += Math.sin(ang) * rnd(5, 11);
          ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
    });
  }
  // Contours: a thin drawn line part way round some of the shapes, the way
  // a painter goes back in with a brush handle to find an edge again.
  function contours() {
    blobs.forEach(function (b) {
      if (b.pts || rand() < 0.45) return;
      b.lobes.forEach(function (lb) {
        if (rand() < 0.3) return;
        var start = rnd(0, Math.PI * 2), span = rnd(0.4, 0.85) * Math.PI * 2, steps = 48;
        ctx.globalAlpha = rnd(0.3, 0.55);
        ctx.strokeStyle = hsla(P.line, rnd(-10, 10), 0, rnd(-5, 10), 1);
        ctx.lineWidth = rnd(0.8, 1.6);
        ctx.beginPath();
        for (var a = 0; a <= steps; a++) {
          var th = start + a / steps * span;
          var px = lb.cx + Math.cos(th) * lb.rx, py = lb.cy + Math.sin(th) * lb.ry;
          var r = 0.7 + 0.6 * fbm(px / 110 + lb.seed, py / 110 + lb.seed) + rnd(-0.03, 0.03);
          px = lb.cx + Math.cos(th) * lb.rx * r; py = lb.cy + Math.sin(th) * lb.ry * r;
          a ? ctx.lineTo(px, py) : ctx.moveTo(px, py);
        }
        ctx.stroke();
      });
    });
  }
  // Scribbles: a handful of loose lines in an accent colour, anywhere.
  function scribbles() {
    var n = Math.round(rnd(3, 8));
    for (var k = 0; k < n; k++) {
      var x = rand() * W, y = rand() * H, ang = rnd(0, Math.PI * 2), segs = Math.round(rnd(20, 45));
      ctx.globalAlpha = rnd(0.4, 0.65);
      ctx.strokeStyle = hsla(pick(P.accent), 0, 0, rnd(-5, 10), 1);
      ctx.lineWidth = rnd(1, 2);
      ctx.beginPath(); ctx.moveTo(x, y);
      for (var j = 0; j < segs; j++) {
        ang += rnd(-0.9, 0.9); x += Math.cos(ang) * rnd(4, 10); y += Math.sin(ang) * rnd(4, 10);
        ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
  }
  // A few drips, as the paint runs.
  function drips() {
    var n = Math.round(W / 22), from = horizon >= 0 ? horizon : H * 0.15;
    for (var k = 0; k < n; k++) {
      var x = rand() * W, y = rnd(from, H * 0.85);
      var reg = regionAt(x, y);
      ctx.globalAlpha = rnd(0.2, 0.45);
      ctx.strokeStyle = hsla(colorAt(reg, x, y), rnd(-6, 6), 0, rnd(-18, -4), 1);
      line(x, y, x + rnd(-3, 3), y + rnd(30, 170), rnd(1, 1.8));
    }
  }
  var PASSES = { branches: branches, contours: contours, scribbles: scribbles, drips: drips };

  var idx = 0, perFrame = Math.ceil(strokes.length / (still ? 1 : 200));
  function step() {
    var end = Math.min(strokes.length, idx + perFrame);
    for (; idx < end; idx++) paint(strokes[idx]);
    if (idx < strokes.length) requestAnimationFrame(step);
    else passes.forEach(function (p) { PASSES[p](); });
  }
  step();
})();
</script>
